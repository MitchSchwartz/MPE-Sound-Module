[Unit]
Description=MPE compiled OUT peak meter (JACK leaf client)
After=mpe-jackd.service surge-xt-cli.service
Wants=mpe-jackd.service
PartOf=mpe-jackd.service
# Opt-in: install-units.sh lists this in DISABLED. Enable only after MPE_PEAK_METER=1
# in /etc/mpe/mpe.env. start-mpe-peak-meter.sh gates on that flag (not ConditionEnvironment).

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
RuntimeDirectory=mpe
RuntimeDirectoryPreserve=yes
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStart=@MPE_MODULE_REPO@/scripts/start-mpe-peak-meter.sh
Restart=on-failure
RestartSec=3
# JACK leaf client — must not inherit 90s default when jackd tears down first.
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

# --- Audio cores (2026-08-21 hygiene baseline) --------------------------------
# The meter is the xrun counter every measurement trusts. Leaving it unpinned
# landed it on CPU1 beside watchdogd, or on CPU0 beside the xhci IRQ the probe
# is trying to measure around. Pin with jackd/surge on 2-3.
#
# mpe-xrun-probe is harness-spawned (no unit); measure-latency-run.sh should
# taskset it to 2-3 before each window when that becomes necessary.
CPUAffinity=2 3

[Install]
WantedBy=multi-user.target

[Unit]
Description=Surge XT global output limiter sync (Conditioner on global FX)
After=surge-xt-cli.service
Wants=surge-xt-cli.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@MPE_MODULE_REPO@/scripts/surge-output-limiter.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

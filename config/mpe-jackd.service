[Unit]
Description=MPE JACK graph server (jackd2)
# sound.target only means the sound subsystem is up, not that the USB DAC has
# enumerated — jackd-prestart.sh does a bounded wait for the card.
After=sound.target
Wants=sound.target
ConditionPathExists=@MPE_MODULE_REPO@/scripts/start-jackd.sh
# No start rate limit: jackd exits immediately when its card is absent, so the
# default burst (5 in 10 s) would put the unit in permanent start-limit failure
# within ~15 s of an unplugged DAC — and then refuse to start when the DAC comes
# back. JACK is the only audio engine (ALSA removed 2026-08-13): a looping
# jackd now DOES mean silence (state=failed, no fallback), which is exactly why
# it must keep retrying forever rather than wedge in start-limit failure and
# need a manual `systemctl reset-failed` to recover when the DAC returns.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
# PipeWire/pulse hold ALSA via the reservation plugin; without this jackd fails to
# open the tier device under systemd even when nothing else is playing audio.
Environment=JACK_NO_AUDIO_RESERVATION=1
# Permit (do not force) realtime scheduling, mirroring surge-xt-cli.service.
# systemd units bypass PAM, so /etc/security/limits.d/audio.conf (installed by
# jackd2) does not apply here.
LimitRTPRIO=95
LimitMEMLOCK=infinity
# /run/mpe holds engine + cooldown state, shared with Surge and the supervisor.
# Preserved so it survives a jackd restart — the supervisor's rate limiting
# depends on state outliving the process it supervises.
RuntimeDirectory=mpe
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
# Device selection on every start — same tier logic as Surge (spec D1).
ExecStartPre=@MPE_MODULE_REPO@/scripts/jackd-prestart.sh
ExecStart=@MPE_MODULE_REPO@/scripts/start-jackd.sh
# The instrument must not stay silent because the server died once.
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

# --- Audio cores (measured 2026-08-20) ---------------------------------------
# Pin the audio path to cores 1-3, which take no interrupts.
#
# The BCM2711's GIC-400 (GICv2) has no usable 1-of-N interrupt distribution, so
# Linux targets the lowest core in each IRQ's mask -- and with the default mask
# that is CPU0 for EVERY interrupt on the system. irqbalance is not installed
# and Raspberry Pi OS does not ship it, so nothing had ever moved them. The USB
# sound card's xhci IRQ, mmc0, the codec and HDMI all landed on CPU0, and JACK's
# RT thread was running there too.
#
# `irqaffinity=0` on the kernel cmdline confines interrupts to core 0;
# this line puts the audio path on the cores that are left. IRQ 30 itself
# cannot be moved -- BRCM-PCI-MSI does not implement set_affinity (EPERM) --
# but that does not matter once audio never runs on CPU0.
#
# Measured at 512x3, n=15 per condition, condition A (synth only):
#   before: mean 4.20 xruns/60s, 0/5 runs clean
#   after:  mean 0.13 xruns/60s, 14/15 runs clean   (t = -4.47)
#
# E1 2026-08-20: widened from `2 3` to `1 2 3`. With two cores, condition A ran
# two processes (jackd, surge) and B/C/D ran three (+ sooperlooper) -- and the
# ONLY significant step in the whole ladder was exactly that 2->3 transition
# (+2.13, t=4.73). Crowding by our own pinning is therefore the leading
# explanation for sooperlooper's cost, ahead of anything in its code. Paired
# with irqaffinity=0 so cores 1-3 stay interrupt-free.
#
# sooperlooper is included because it is a JACK graph client -- its callback
# runs in the process chain, so leaving it on cores 0-1 puts graph work back
# next to the interrupts.
#
# docs/measurements/low-latency-step0-step1-2026-08-19.md
CPUAffinity=1 2 3

[Install]
WantedBy=multi-user.target

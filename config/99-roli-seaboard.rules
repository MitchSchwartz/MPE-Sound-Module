# ROLI Ltd USB controllers (Seaboard BLOCK, LUMI Keys, … — vendor 2af4)
# Restart the pressure remapper so RtMidi reopens the ALSA port after power-cycle / hot-plug.
# Surge reads remapped MIDI via Midi Through; remapper must not keep a stale port handle.

# Disable USB autosuspend (prevents random disconnects on battery-powered controllers)
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2af4", ATTR{power/autosuspend}="-1"

# Debounced reconnect — scripts/roli-connect-debounce.sh
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2af4", RUN+="/bin/bash @MPE_MODULE_REPO@/scripts/roli-connect-debounce.sh add"
ACTION=="remove", SUBSYSTEM=="usb", ATTR{idVendor}=="2af4", RUN+="/bin/bash @MPE_MODULE_REPO@/scripts/roli-connect-debounce.sh remove"

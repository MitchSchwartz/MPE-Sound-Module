[Unit]
Description=MPE USB Audio Gadget (UAC2 host passthrough)
Documentation=file:@MPE_MODULE_REPO@/docs/USB-AUDIO-HOST.md
DefaultDependencies=no
After=local-fs.target
Before=surge-xt-cli.service
ConditionPathExists=@MPE_MODULE_REPO@/scripts/setup-usb-audio-gadget.sh

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/mpe/mpe.env
ExecStart=@MPE_MODULE_REPO@/scripts/setup-usb-audio-gadget.sh start
ExecStop=@MPE_MODULE_REPO@/scripts/setup-usb-audio-gadget.sh stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

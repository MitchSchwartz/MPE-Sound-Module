# Copy to config/mpe.env (PC) or /etc/mpe/mpe.env (Pi) and edit.
# config/mpe.env is gitignored — safe for machine-specific paths.
#
# After editing on the Pi, run:
#   ./scripts/configure-pi-paths.sh --local --force
#   sudo systemctl restart patch-browser

# --- PC: repo locations (optional if assets repo is ../mpe-assets) ---
# MPE_PERSONAL_REPO=/path/to/mpe-assets

# --- PC: Surge XT install (optional — defaults to ~/Documents/Surge XT) ---
# SURGE_XT_DIR=/path/to/Documents/Surge XT

# --- Pi SSH (laptop-side deploy scripts) ---
# PI_HOST=raspberrypi2.local
# REQUIRED — no safe default. Raspberry Pi Imager makes you set a custom
# username per device (there's no more shipped "pi" default), so this must
# match whatever username you set when you flashed the SD card.
# PI_USER=your-pi-username
# SSH_KEY=$HOME/.ssh/your_pi_key

# --- Pi: clone locations (only if not in $HOME) ---
# PI_MPE_MODULE=/home/your-pi-username/MPE-Module
# PI_MPE_PERSONAL=/home/your-pi-username/mpe-assets

# --- Pi runtime (scripts/services on the device) ---
# MPE_MODULE_REPO=$HOME/MPE-Module
# MPE_PERSONAL_REPO=$HOME/mpe-assets
# MPE_SURGE_ROOT=$HOME/surge
# MPE_SURGE_DOCS="$HOME/Documents/Surge XT"
# MPE_SURGE_LOG=$HOME/surge-cli.log
# MPE_PI_USER=your-pi-username
# MPE_HOME=/home/your-pi-username  # set by configure-pi-paths.sh --local

# --- Audio output profile (Pi) ---
#
# standalone — Sound Blaster Play! 3 → 3.5 mm analog (default, gig/couch)
# usb-host   — UAC2 USB gadget → tethered laptop/PC (Surge direct to host when capturing)
# usb-host-session — Surge on Sound Blaster; RC-5 return (mic in) → USB when PC captures
#
# usb-host / usb-host-session require one-time boot config: dtoverlay=dwc2,dr_mode=peripheral
# See docs/USB-AUDIO-HOST.md and docs/USB-SESSION-RECORD.md
#
# Persisted in /etc/mpe/mpe.env — survives reboot and configure-pi-paths --force
# (toggle in touch settings also writes this file via set-audio-profile.sh).
# MPE_AUDIO_PROFILE=standalone
#
# Keep the UAC2 USB gadget bound when switching to analog (default: 1).
# Host DAWs (e.g. REAPER + PipeWire) keep the same capture device — no restart.
# Surge routes to Sound Blaster in standalone; the host input is silent until USB mode.
# Set 0 to fully tear down the gadget on analog (old behavior).
# MPE_USB_GADGET_PERSIST=1
#
# --- DAC hardware output (Sound Blaster Play! 3, standalone profile) ---
# Post-JACK analog level on the USB DAC Speaker control (not Surge OSC volume).
# Applied at boot, after graph restart, and by configure-pi-paths.sh.
# Scale: raw 0–88, dB ≈ (raw - 88) * 0.5  →  64 = -12 dB, 48 = -20 dB, 76 = -6 dB
# Override with exact step: MPE_DAC_SPEAKER_RAW=64
# MPE_DAC_VOLUME_DB=-12

# Vol fader law (touch browser): console (IEC default) or linear-in-dB
# MPE_VOL_FADER_LAW=console

# --- Audio engine (Pi — JACK graph server) ---
# JACK is the only audio engine (spec amended 2026-08-13 — ALSA removed
# entirely, not just its automatic fallback). MPE_AUDIO_ENGINE is retired —
# there is nothing left to select.
#
# Server-side period — distinct from MPE_SURGE_BUFFER_SIZE (spec D6).
# Proven-good on Sound Blaster Play! 3: 256 frames x 3 periods @ 48 kHz.
# MPE_JACK_BUFFER=256
# MPE_JACK_PERIODS=3
# MPE_JACK_RT_PRIORITY=70
# MPE_JACK_READY_TIMEOUT_S=10

# --- Surge audio buffer (legacy knob — mirrored when touch UI changes buffer) ---
# Under JACK, audible latency is MPE_JACK_BUFFER × MPE_JACK_PERIODS / sample_rate.
# This key is kept in sync for MIDI offset auto-derivation and calibration only;
# it does not set Surge's JACK callback period (the server does).
# MPE_SURGE_BUFFER_SIZE=1024
# MPE_SURGE_BUFFER_SIZE=2048

# --- Latency experiment knobs (Pi — see docs/LATENCY-SPIKE.md, Arm A½) ---
# Both default to OFF so existing appliances are unchanged. Change ONE at a time.
#
# Pin the CPU frequency governor (mpe-cpu-governor.service runs at boot).
# Stock Pi OS uses "ondemand", which ramps clock on demand and can drop voices
# on polyphony spikes. "performance" removes the ramp at the cost of power/heat.
# Unset = leave the distro default alone.
# MPE_CPU_GOVERNOR=performance
#
# MPE_SURGE_RT_PRIORITY — RETIRED 2026-08-14, has no consumer.
# The `chrt` wrapper this triggered lived on the ALSA launch path, which PR #50
# removed. Setting it does nothing. Under JACK, jackd elevates Surge's audio
# callback thread to SCHED_FIFO ~65 on its own, backed by LimitRTPRIO=95 in
# surge-xt-cli.service — that is the mechanism now, and it is already on.
#
# Do not use `chrt -p $(pgrep -f surge-xt-cli)` to check it: that reads the
# PROCESS, which is SCHED_OTHER by design under JACK. Use `mpe rt status`,
# which reads the audio thread.

# --- Surge sample rate (Pi — ALSA + UAC2 gadget must match) ---
# Default: 48000 Hz. usb-host gadget p_srate uses the same value.
# MPE_SURGE_SAMPLE_RATE=48000
# Mic→UAC2 bridge ALSA period size (frames); default 512 ≈ 10.7 ms @ 48 kHz per leg
# (256 crackles under load on Pi — underruns in mic-to-uac2-bridge.log)
# MPE_MIC_BRIDGE_BUFFER_SIZE=512

# --- Playback policy (Pi) ---
# Reuse Single: rewrite XML patches at load so restrikes reuse the same voice (always on by default).
# MPE_REUSE_SINGLE=1
# Static poly ceiling applied on each patch load (before dynamic governor adjusts further).
# MPE_POLY_CEILING=12
# MPE_POLY_FLOOR=4
# Emergency poly when CPU >= 90% (below floor; default 3).
# MPE_POLY_EMERGENCY=3
# Reserve voices below ceiling on patch load when governor is on (default 3).
# MPE_POLY_GOVERNOR_HEADROOM=3
# Dynamic CPU governor daemon (surge-poly-governor.service); toggle in touch settings also applies.
# MPE_POLY_GOVERNOR=1
# Defer poly step-down until MIDI voice count allows (V7 Fix 2); emergency sends note-offs.
# MPE_POLY_GOVERNOR_FADE=1
# Governor poll interval in seconds (default 0.15).
# MPE_POLY_POLL_INTERVAL_S=0.15
# CPU thresholds (% process CPU proxy) and hold times — defaults match shipped constants.
# MPE_POLY_CPU_EMERGENCY=90.0
# MPE_POLY_CPU_SPIKE=78.0
# MPE_POLY_CPU_HIGH=78.0
# MPE_POLY_CPU_WARM=48.0
# MPE_POLY_CPU_LOW=68.0
# MPE_POLY_CPU_HIGH_HOLD_S=0.15
# MPE_POLY_CPU_LOW_HOLD_S=5.0
# MPE_POLY_PATCH_WARM_WINDOW_S=4.0
# MPE_POLY_STEP_DOWN=2
# MPE_POLY_STEP_DOWN_SPIKE=4
# MPE_POLY_STEP_DOWN_WARM=2
# MPE_POLY_STEP_UP=1
# --- Poly governor v2 (always-on jack deadline + baseline loosen; opt-in until Pi tune + Gate B) ---
# MPE_POLY_GOVERNOR_V2=1
# MPE_POLY_GOVERNOR_METER=jack
# MPE_POLY_LIMIT_MODE=always_on
# MPE_POLY_JACK_BASELINE=75
# MPE_POLY_MIN_HEADROOM=3
# MPE_POLY_LIMIT_HARD=100
# MPE_POLY_EMERGENCY_XRUN_ONLY=1
# MPE_POLY_RAMP_APPLY=1
# MPE_POLY_RISE_ENABLE=1
# MPE_POLY_RISE_FULL_RATE=65
# MPE_POLY_RISE_BIAS_MAX=8
# MPE_POLY_RISE_MIN_RATE=20
# MPE_POLY_LIMIT_MAX_STEP_DOWN=1
# MPE_POLY_LIMIT_STEP_INTERVAL_S=0.25
# MPE_POLY_LIMIT_RECOVER_HOLD_S=5.0
# MPE_POLY_POLL_FAST_S=0.05
# MPE_POLY_POLL_SLOW_S=0.15
# MPE_POLY_XRUN_NUDGE=8.0
# Threshold-gated progressive mode (A/B): MPE_POLY_LIMIT_MODE=progressive + SOFT_START/HARD
# MPE_POLY_LIMIT_SOFT_START=68
# MPE_POLY_LIMIT_HARD=86
# High-rate diagnostic trace on tmpfs (/run/mpe/poly-governor.trace), not journal.
# MPE_POLY_GOVERNOR_VERBOSE=0

# --- Patch browser UI (Pi — picked at boot via configure-pi-paths.sh) ---
#
# oled    — encoder + 1.3" OLED (patch-browser.service + boot-animation)
# touch   — Freenove 5″ DSI / 800×480 landscape (touch-patch-browser.service)
#
# Set per Pi in config/mpe.env (or /etc/mpe/mpe.env), then:
#   ./scripts/configure-pi-paths.sh --local --force
# MPE_UI_MODE=oled

# --- Patch browser UI controls (read by patch-browser.service) ---
#
# Quick-access folder: user patch category pinned first in the browser.
# On disk:  ~/Documents/Surge XT/Patches/<name>/  (default name includes !)
# On OLED:  same as <name> — use a leading ! to pin first (default: !Quick Access)
#
# Default: !Quick Access (leading ! sorts first in Surge and on the device).
# Examples: Live, "!Gig Bag", Live Set
# MPE_FAVORITES_NAME="!Quick Access"

# --- MIDI clock (Boss RC-5 — looper as master by default) ---
# RC-5 USB Type-B → Pi. See docs/MIDI-CLOCK.md
MPE_MIDI_CLOCK_IN_ENABLED=1
MPE_MIDI_CLOCK_IN_PORT=RC-5
# Optional Pi-as-master (send clock to pedal):
# MPE_MIDI_CLOCK_OUT_ENABLED=1
# MPE_MIDI_CLOCK_BPM=120
# MPE_MIDI_CLOCK_PORT=RC-5
# MPE_MIDI_CLOCK_AUTO_START=1

# Output timing (Roli → Surge via mpe-pressure-remap)
# Negative offset = advance notes to compensate for Surge buffer latency.
# MPE_MIDI_OUTPUT_OFFSET_MS=-21
# MPE_MIDI_OUTPUT_OFFSET_AUTO=1   # default: -buffer_ms from MPE_SURGE_BUFFER_SIZE
# MPE_MIDI_QUANTIZE=16th          # off | beat | 8th | 16th | 32nd
# MPE_MIDI_QUANTIZE_TRIPLET=0     # 1 = triplet grid for chosen subdivision
# MPE_MIDI_CLOCK_THROUGH=1        # advanced: pass Roli 0xF8/FA/FB/FC to Surge (not RC-5 clock)

# --- SooperLooper grid (APC bench + engine) ---
# Crossfade at loop wrap — samples @ 48 kHz (256 ≈ 5.3 ms).
# MPE_SL_FADE_SAMPLES=256
# Phase re-anchor: second set_tempo at loop wrap when PLAYING arrived mid-bar.
# Grid establishment is immediate; only phase realignment waits for wrap.
# MPE_SL_GRID_ANCHOR_MAX_S=0.015
# MPE_SL_GRID_ANCHOR_FALLBACK_CYCLES=1.1
# MPE_SL_BENCH_LOOP_POS_MS=20     # loop_pos poll for phase re-anchor (default 20 ms)
# Loop seam (looper-loop-seam-spec.md): stop-then-weld on every clip close.
# Pad fixes length immediately (defining) or at bar (grid); release captured on
# scratch loop (default 14 on Pi — loop 15 save_loop is empty on arm64 SL 1.7.9)
# and merged once at the wrap seam — not by extending Recording.
# MPE_SL_TAIL_CAPTURE=1
# MPE_SL_TAIL_THRESH=0.02
# MPE_SL_TAIL_HOLD_MS=80
# MPE_SL_TAIL_MAX_MS=750
# MPE_SL_TAIL_PEAK_MS=25
# Offline seam merge (default on; set 0 for stop-only, no reload):
# MPE_SL_SEAM_WELD=1
# MPE_SL_SCRATCH_LOOP=14
# MPE_SL_SCRATCH_CAPTURE_WET=0
# MPE_SL_SCRATCH_CAPTURE_FEEDBACK=0
# MPE_SL_MIN_TAIL_WAV_BYTES=512
# MPE_SL_SEAM_MERGE_SAMPLES=2048
# MPE_SL_AUTOSET_LATENCY=1
# MPE_SL_INPUT_LATENCY=           # optional override in samples

# --- Touch UI (5" DSI test Pi — touch-patch-browser.service) ---
# MPE_TOUCH_WINDOWED=1          # windowed dev mode instead of fullscreen KMS
#
# Demo screen record — set by scripts/record-screen.sh (do not leave enabled):
# MPE_SCREEN_RECORD=1
# MPE_SCREEN_RECORD_PIPE=/tmp/mpe-screen-record.pipe
# MPE_SCREEN_RECORD_FPS=30
# MPE_SCREEN_RECORD_WIDTH=800
# MPE_SCREEN_RECORD_HEIGHT=480
#
# Shutdown diagnostics: skip branded splash; log each step to logs/shutdown-trace.jsonl.
# After a test shutdown, run ./scripts/shutdown-measure-last.sh
# MPE_SHUTDOWN_SKIP_SPLASH=1

# Compiled OUT peak meter (Phase 5). Off until bench-xruns --strict passes.
# MPE_PEAK_METER=1

# Audio-path entry point 2 (Documents/DECISIONS.md 2026-08-18): pygame.init()
# initialises every SDL subsystem including the mixer, so the touch UI, the boot
# splash and the calibration loader each opened the Pi's onboard headphone jack and
# streamed 44.1 kHz silence on a clock domain of their own. Measured 2026-08-18:
# 41 xruns / 75 s with DSP never above 55%. Nothing in this repo plays a sound.
# Leave this set. The only PCM that should ever be open is the DAC's.
SDL_AUDIODRIVER=dummy

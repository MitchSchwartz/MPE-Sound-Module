[Unit]
Description=Patch Browser UI for OLED Display
After=surge-xt-cli.service boot-animation.service
Wants=surge-xt-cli.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
ExecStartPre=/bin/sleep 2
ExecStart=@MPE_MODULE_REPO@/scripts/start-patch-browser.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

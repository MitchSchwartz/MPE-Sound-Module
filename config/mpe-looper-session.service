[Unit]
Description=Looper session — APC bench + HUD state (Phase 3M merge)
# Started by udev when an APC is plugged in, and stopped when it is removed:
# config/99-apc-looper.rules, the same pattern as the foot pedal. There is no
# [Install] section. With no APC there is nothing for this process to drive, and
# from 2026-09 to 2026-10-11 starting it at boot without one produced a crash
# loop: exit 1 every 10.5 s, 3535 restarts, xruns inside the restarts (#154).
#
# Ordering only, and deliberately tolerant of the engine being absent: the session
# re-registers OSC auto-updates every MPE_SL_BENCH_REREGISTER_S (15 s), so it
# recovers on its own once the engine returns. Binding it to the engine would
# instead tear the controller down every time the engine restarted.
After=mpe-sooperlooper.service
Wants=mpe-sooperlooper.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
# Binds UDP 9953 (shared bench + HUD auto-update). Startup fails loudly if held.
ExecStart=/usr/bin/python3 @MPE_MODULE_REPO@/scripts/looper-session.py
# Restart=always stays: a session that dies while an APC is plugged in must come
# back (the 2026-08-17 six-hour outage). The one exception is 69, which
# looper_session.py returns when no APC card is present
# (patch_browser/apc_presence.py APC_ABSENT_EXIT). That status is a clean stop
# with no restart. udev starts the unit again when an APC appears.
Restart=always
RestartSec=10
RestartPreventExitStatus=69
SuccessExitStatus=69
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

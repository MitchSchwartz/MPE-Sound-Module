[Unit]
Description=USB Foot Pedal to Surge OSC Bridge
After=network.target surge-xt-cli.service
Requires=surge-xt-cli.service

[Service]
Type=simple
User=@MPE_PI_USER@
Group=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
ExecStart=/usr/bin/python3 @MPE_MODULE_REPO@/scripts/pedal-to-osc.py
TimeoutStopSec=10
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=journal
SupplementaryGroups=input

[Install]
WantedBy=

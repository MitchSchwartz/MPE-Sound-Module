[Unit]
Description=USB Foot Pedal to Surge OSC Bridge
Documentation=https://github.com/MitchSchwartz/MPE-Module
After=network.target surge-xt-cli.service
Requires=surge-xt-cli.service

[Service]
Type=simple
User=<user>
Group=<user>
WorkingDirectory=/home/<user>/MPE-Module
ExecStart=/usr/bin/python3 /home/<user>/MPE-Module/scripts/pedal-to-osc.py
# No automatic restart - udev rule will trigger on device connection
Restart=no
StandardOutput=journal
StandardError=journal

# Allow access to input devices
SupplementaryGroups=input

[Install]
# Not enabled by default - started by udev rule when pedal connects
WantedBy=

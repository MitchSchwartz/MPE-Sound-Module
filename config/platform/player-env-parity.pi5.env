# Pi 5 player parity — provisional tune (BCM2712 / RP1).
# Applied by scripts/apply-player-env-parity.sh (auto-selects this file on Pi 5).
# Governor block is v2 (always_on + jack meter) — complete; Gate B not closed on hardware.
# Do NOT add MPE_POLY_CPU_HIGH / MPE_POLY_CPU_LOW (Pi 4 v1 only).
# See docs/measurements/poly-governor-v2-always-on-pi5-2026-08-23.md

MPE_FAVORITES_NAME="Quick Select"
MPE_UI_MODE="touch"
MPE_AUDIO_PROFILE=standalone
# Buffer: 64 is the reference-unit daily setting as of 2026-08-27 — EAR-VALIDATED
# ONLY, no xrun soak. See docs/measurements/pi5-buffer-64-ear-2026-08-27.md
#
# It has now collapsed ALSA/USB TWICE: 2026-08-23 (no logs) and 2026-08-30. The
# second one IS diagnosed — 0 xruns/hour all morning, then 11 and 24 as the poly
# governor hit 43 voices at cpu=100.0, and both USB devices sharing
# xhci-hcd:usb3 dropped inside that window (the ROLI for good). Power is
# excluded by measurement: the dock's hub is self-powered, throttled=0x0.
# docs/measurements/pi5-buffer-64-usb-collapse-2026-08-30.md
#
# The fallback below is 128, and the second trigger for it has now fired. It is
# NOT applied automatically: 64->128 doubles JACK buffering on an instrument
# judged by touch, and that trade is the operator's to make.
#
# NOTE the drift: apply-player-env-parity.sh PRESERVES a live value, so the
# reference unit runs 64x3 and MPE_SURGE_BUFFER_SIZE=1024 — not the 64x2/128
# written here. This file describes a fresh appliance, not necessarily yours.
MPE_JACK_BUFFER=64
MPE_SURGE_BUFFER_SIZE=128
MPE_SURGE_SAMPLE_RATE=48000
MPE_DAC_VOLUME_DB=-12
MPE_CPU_GOVERNOR=performance
MPE_JACK_SOFTMODE=0
MPE_JACK_PERIODS=2
MPE_PEAK_METER=1
SDL_AUDIODRIVER=dummy
MPE_SL_AUTOSET_LATENCY=0
MPE_SL_INPUT_LATENCY=3072
# 15, not 16: SooperLooper 1.7.9 on arm64 gives fifteen usable loops and a
# PHANTOM at index 15 that answers reads and silently discards writes
# (sl_limits.py, MEASURED 2026-08-27). This file said 16, and merges into
# the same /etc/mpe/mpe.env that bootstrap-pi5-looper.sh sets to 15 — two
# writers of one file, disagreeing, with the later one winning.
MPE_SL_LOOPS=15

# Poly governor v2 — ear tune 2026-08-23 (provisional until PSU/cooler + Gate B)
MPE_POLY_GOVERNOR_V2=1
MPE_POLY_GOVERNOR_METER=jack
MPE_POLY_LIMIT_MODE=always_on
MPE_POLY_JACK_BASELINE=97
MPE_POLY_MIN_HEADROOM=3
MPE_POLY_RISE_BIAS_MAX=7
MPE_POLY_RAMP_APPLY=1
MPE_POLY_REST_CAP=40
MPE_POLY_STEP_UP=0
MPE_POLY_LIMIT_HARD=100
MPE_POLY_EMERGENCY_XRUN_ONLY=1
MPE_POLY_CEILING=64
MPE_POLY_FLOOR=4
MPE_POLY_RISE_FULL_RATE=65
MPE_POLY_RISE_MIN_RATE=20

# MIDI: apt python3-rtmidi — do not set RTMIDI_API.

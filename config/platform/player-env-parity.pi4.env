# Pi 4 player parity — raspberrypi2 certified stack (BCM2711).
# Applied by scripts/apply-player-env-parity.sh (auto-selects this file on Pi 4).
# Governor block is v1 (proc CPU meter) — complete; do not merge partial MPE_POLY_* keys.

MPE_FAVORITES_NAME="Quick Select"
MPE_UI_MODE="touch"
MPE_AUDIO_PROFILE=standalone
MPE_JACK_BUFFER=1024
MPE_SURGE_BUFFER_SIZE=1024
MPE_SURGE_SAMPLE_RATE=48000
MPE_DAC_VOLUME_DB=-12
MPE_CPU_GOVERNOR=performance
MPE_JACK_SOFTMODE=0
MPE_JACK_PERIODS=3
MPE_PEAK_METER=1
SDL_AUDIODRIVER=dummy
MPE_SL_AUTOSET_LATENCY=0
MPE_SL_INPUT_LATENCY=3072
MPE_SL_LOOPS=8

# Poly governor v1 — G2 recalibrated 2026-08-23 (PI4-CLOSEOUT)
MPE_POLY_GOVERNOR=1
MPE_POLY_GOVERNOR_FADE=1
MPE_POLY_CEILING=64
MPE_POLY_FLOOR=64
MPE_POLY_CPU_HIGH=78.0
MPE_POLY_CPU_LOW=68.0

# MIDI: apt python3-rtmidi — do not set RTMIDI_API.

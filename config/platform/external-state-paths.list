# Paths captured/restored by scripts/provision/capture-external-state.sh
# and apply-external-state.sh. One path per line; # comments and blank lines ignored.
# Paths are relative to the Pi user's home unless absolute.
#
# Pi 5 audit: run capture --check on raspberrypi5 and diff against actual home
# (includes .patch_browser_poly_state.json — ceiling_poly / effective_poly).
#
# NEVER captured (hard-coded in capture script):
#   ~/.ssh/*  host keys, authorized_keys, known_hosts
#   /var/lib/tailscale/*  Tailscale node identity — never in an image
#   ~/.mpe_clock_*.json  tempfile scratch from midi_clock.py
#   NetworkManager WiFi profiles (PSKs), shell history, machine-id
#
# Built by build-appliance.sh (not external state):
# Also captured separately: etc/systemd-dropins/, boot/dsi-config.snippet, platform.json
#   OS, apt, Surge binary, factory/3rd-party patches, systemd units, cmdline hygiene
#   MPE-Module @ tag, native meters, touch deps, SooperLooper (--with-looper only)

/etc/mpe/mpe.env
surge-cli-calibration.log
.patch_browser_brightness.json
.patch_browser_favorites.json
.patch_browser_hold.json
.patch_browser_last_patch.json
.patch_browser_metadata.json
.patch_browser_normalization.json
.patch_browser_poly_state.json
.patch_browser_pressure.json
.patch_browser_pressure_live.json
.patch_browser_ui.json
.patch_browser_volume.json
.patch_browser_calibration_backups
.patch_browser_favorites_backups
.mpe_sl_hud_state.json
.mpe_midi_clock_state.json
.mpe_sl_watchdog.json
.mpe_sl_master_clock.json
.mpe_looper_timing.json
.local/share/Surge XT

# Non-path appliance keys — match Pi 4 control (raspberrypi2) for like-for-like player behaviour.
# Applied by scripts/apply-player-env-parity.sh after configure-pi-paths.sh.
# Do NOT put MPE_PI_USER, MPE_HOME, or repo paths here — those come from configure-pi-paths.

MPE_FAVORITES_NAME="Quick Select"
MPE_UI_MODE="touch"
MPE_AUDIO_PROFILE=standalone
MPE_JACK_BUFFER=128
MPE_SURGE_BUFFER_SIZE=128
MPE_SURGE_SAMPLE_RATE=48000
MPE_DAC_VOLUME_DB=-12
MPE_CPU_GOVERNOR=performance
MPE_JACK_SOFTMODE=0
MPE_PEAK_METER=1
MPE_JACK_PERIODS=2
SDL_AUDIODRIVER=dummy
MPE_SL_AUTOSET_LATENCY=0
MPE_SL_INPUT_LATENCY=3072
MPE_SL_TAIL_MODE=extend
MPE_SL_LOOPS=8
MPE_POLY_GOVERNOR=1
MPE_POLY_GOVERNOR_FADE=1
MPE_POLY_CEILING=64
MPE_POLY_FLOOR=64
MPE_POLY_CPU_HIGH=78.0
MPE_POLY_CPU_LOW=68.0

# MIDI: Pi 4 uses apt python3-rtmidi with NO RTMIDI_API override.
# Audio graph is JACK (jackd2); MIDI is ALSA Midi Through ← mpe-pressure-remap ← Roli USB.
# Do not set RTMIDI_API here.

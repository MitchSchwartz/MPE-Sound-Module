[Unit]
Description=Boot Animation for OLED Display
After=systemd-modules-load.service local-fs.target
Before=surge-xt-cli.service patch-browser.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment="BOOT_ANIM_DURATION=40"
ExecStart=/usr/bin/python3 @MPE_MODULE_REPO@/boot_animation.py
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
TimeoutStopSec=2
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

[Unit]
Description=Boot Animation for OLED Display
After=systemd-modules-load.service local-fs.target
Before=surge-xt-cli.service patch-browser.service

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/MPE-Module
Environment="BOOT_ANIM_DURATION=40"
ExecStart=/usr/bin/python3 /home/<user>/MPE-Module/boot_animation.py
RemainAfterExit=no
StandardOutput=journal
StandardError=journal
TimeoutStopSec=2
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

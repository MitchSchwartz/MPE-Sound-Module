[Unit]
Description=MPE pressure floor MIDI remapper (Light fader)
After=sound.target
Before=surge-xt-cli.service
PartOf=surge-xt-cli.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
ExecStart=@MPE_MODULE_REPO@/scripts/mpe-pressure-remap.py
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

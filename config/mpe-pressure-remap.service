[Unit]
Description=MPE pressure floor MIDI remapper (Touch fader)
After=sound.target
Before=surge-xt-cli.service
# udev (99-roli-seaboard.rules) restarts this unit on hot-plug; no crash loop at boot.

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@MPE_MODULE_REPO@/scripts/start-mpe-pressure-remap.sh
Restart=no
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

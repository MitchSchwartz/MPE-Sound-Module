[Unit]
Description=MPE pressure floor MIDI remapper (Touch fader)
After=sound.target
Before=surge-xt-cli.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@MPE_MODULE_REPO@/scripts/mpe-pressure-remap.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

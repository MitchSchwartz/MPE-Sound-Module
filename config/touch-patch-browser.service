[Unit]
Description=Touch Patch Browser UI for 5 inch DSI Display
After=surge-xt-cli.service touch-boot-animation.service
Wants=surge-xt-cli.service touch-boot-animation.service
Conflicts=patch-browser.service

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
EnvironmentFile=-/tmp/mpe-screen-record.env
# The OUT meter (MPE_PEAK_METER=1) registers a JACK client from inside this process,
# and jackd's realtime cycle then waits on that client's callback every period. Without
# these, the callback thread cannot be promoted to SCHED_FIFO — measured on the
# appliance 2026-08-17: `Max realtime priority: 0`, every UI thread SCHED_OTHER, so
# jackd (FIFO 70) was blocking on a normal-priority Python thread. That is a priority
# inversion, and it is why small periods crackled. systemd units bypass PAM, so
# /etc/security/limits.d/audio.conf does not apply here.
LimitRTPRIO=95
LimitMEMLOCK=infinity
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_MOUSE_TOUCH_EVENTS=1
ExecStartPre=@MPE_MODULE_REPO@/scripts/prepare-dsi-display.sh
ExecStart=@MPE_MODULE_REPO@/scripts/start-touch-patch-browser.sh
TimeoutStopSec=10
KillMode=control-group
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target

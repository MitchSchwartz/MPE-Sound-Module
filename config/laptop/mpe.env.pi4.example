# Laptop mpe-cli — Pi 4 reference (raspberrypi2)
# Copy: cp config/laptop/mpe.env.pi4.example ~/.config/mpe/mpe.env.pi4
# Use:  MPE_CLI_CONFIG=~/.config/mpe/mpe.env.pi4 mpe ping

PI_HOST=raspberrypi2.local
PI_USER=mitch
SSH_KEY=$HOME/.ssh/surge_pi_key
PI_MPE_MODULE=/home/mitch/MPE-Module

# Optional: pin repo-side deploy env (scripts/image/* use config/mpe.env when unset)
# MPE_ASSETS_DIR=$HOME/path/to/mpe-assets

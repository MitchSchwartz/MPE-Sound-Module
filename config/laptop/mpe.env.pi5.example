# Laptop mpe-cli — Pi 5 player (raspberrypi5)
# Copy: cp config/laptop/mpe.env.pi5.example ~/.config/mpe/mpe.env.pi5
# Use:  MPE_CLI_CONFIG=~/.config/mpe/mpe.env.pi5 mpe ping

PI_HOST=raspberrypi5.local
PI_USER=pi
SSH_KEY=$HOME/.ssh/surge_pi5_key
PI_MPE_MODULE=/home/pi/MPE-Module

# Pi 5 appliance git ref during validation: dev (see config/platform/appliance-git-ref.pi5)

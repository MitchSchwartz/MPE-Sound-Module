[Unit]
Description=SooperLooper engine (16 loops on the JACK graph)
# Ordering only. Not Requires/BindsTo on mpe-jackd: a jackd restart must not tear
# the engine down, because sl-watchdog's whole job is repairing the orphan that
# leaves behind — and it cannot repair a unit systemd has stopped underneath it.
# run-sooperlooper.sh does its own bounded wait for the server accepting clients,
# since After= only sequences activation, not readiness.
After=mpe-jackd.service surge-xt-cli.service
Wants=mpe-jackd.service
# No start rate limit, matching mpe-jackd. The engine is worth retrying exactly
# when the appliance is unstable, which is when the default burst would retire it
# and leave the looper silently dead — the 2026-08-17 failure, where the engine
# died at 16:15 and nothing restarted it for six hours.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@MPE_PI_USER@
WorkingDirectory=@MPE_MODULE_REPO@
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
# The engine is a JACK client; jackd assigns its audio thread priority. systemd
# units bypass PAM, so /etc/security/limits.d/audio.conf does not apply here.
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStart=@MPE_MODULE_REPO@/scripts/sooperlooper/run-sooperlooper.sh
# Grid sync + record/playback wiring, after the client is actually on the bus.
ExecStartPost=@MPE_MODULE_REPO@/scripts/sooperlooper/wire-sooperlooper-graph.sh
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Pi-Surge-MPE .gitignore

# Python bytecode
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Dev scratch files
scratch.*

# SSH keys (NEVER commit these!)
*.pem
*_key
*_key.pub
id_rsa*
id_ed25519*

# Local dev/test files (repo root only — tests/ is tracked for CI)
/test_*.py
config.local.ini
config/mpe.env
state/
artifacts/golden-pi4/
artifacts/golden-pi5/
*.img
*.img.xz
*.local.*
logs/shutdown-trace.jsonl
logs/shutdown-test-marker.json

# Headless nerdrack config (copy from *.headless.example on the build box only)
.claude/settings.local.json
.claude/mcp.json
.yolo/headless

# Everything else (binaries, patches, configs) GOES IN GIT for backup!
native/mpe-peak-meter/mpe-peak-meter

# Compiled probe — build with `make` in native/mpe-xrun-probe.
# An x86-64 laptop build was committed here and shipped to the aarch64 Pi,
# where a fresh checkout produced "Syntax error: Unterminated quoted string"
# because the shell tried to execute a foreign-architecture ELF (2026-08-20).
native/mpe-xrun-probe/mpe-xrun-probe

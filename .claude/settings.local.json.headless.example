{
  "_README": "NERDRACK / Claude YOLO ONLY — copy to .claude/settings.local.json on the headless build box. Do NOT use on laptop. After copy: bash scripts/yolo/check-guardrails.sh. OneCLI agent: IO MPE Module. Secret: github-mpe-module.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/yolo/yolo-shell-guard.sh",
            "env": {
              "YOLO_HOOK_AGENT": "claude"
            }
          },
          {
            "type": "command",
            "command": "bash scripts/yolo/agentjail-hook-wrapper.sh",
            "env": {
              "YOLO_HOOK_AGENT": "claude"
            }
          }
        ]
      }
    ]
  }
}

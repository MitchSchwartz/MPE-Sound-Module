[Unit]
Description=USB Foot Pedal to Surge OSC Bridge
After=network.target surge-xt-cli.service
Requires=surge-xt-cli.service

[Service]
Type=simple
User=mitch
Group=mitch
WorkingDirectory=/home/mitch/MPE-Module
EnvironmentFile=-/etc/mpe/mpe.env
ExecStart=/usr/bin/python3 /home/mitch/MPE-Module/scripts/pedal-to-osc.py
TimeoutStopSec=10
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=journal
SupplementaryGroups=input

[Install]
WantedBy=

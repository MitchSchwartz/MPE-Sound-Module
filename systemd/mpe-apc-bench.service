[Unit]
Description=APC mini clip grid + transport for SooperLooper
# Ordering only, and deliberately tolerant of the engine being absent: the bench
# re-registers OSC auto-updates every MPE_SL_BENCH_REREGISTER_S (15 s), so it
# recovers on its own once the engine returns. Binding it to the engine would
# instead tear the controller down every time the engine restarted.
After=mpe-sooperlooper.service
Wants=mpe-sooperlooper.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mitch
WorkingDirectory=/home/mitch/MPE-Module
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
# Binds UDP MPE_SL_BENCH_LISTEN_PORT (default 9953) for OSC state replies, and
# refuses to run if another instance holds it — see sl_bench_listener.start(),
# which exits rather than run blind with pads that lie. RestartSec is long enough
# for a stale holder's socket to clear rather than spinning against it.
ExecStart=/usr/bin/python3 /home/mitch/MPE-Module/scripts/sooperlooper-apc-bench.py
Restart=always
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

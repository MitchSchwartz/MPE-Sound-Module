[Unit]
Description=SooperLooper HUD state writer (transport + graph health for the touch UI)
# Ordering only. This writes ~/.mpe_sl_hud_state.json, which the touch browser reads
# to draw the looper bar; it polls and degrades to "no engine" on its own, so binding
# it to the engine would only mean the HUD dies with the thing it reports on.
After=mpe-sooperlooper.service
Wants=mpe-sooperlooper.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=mitch
WorkingDirectory=/home/mitch/MPE-Module
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/mitch/MPE-Module/scripts/sooperlooper/sl-hud-monitor.py
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

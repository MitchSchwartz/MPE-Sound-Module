[Unit]
Description=MPE on-device looper (APC Session View grid)
# mpe-jackd, not just sound.target: JACK is the only audio engine, and a looper
# started before the graph server has no bus to register a client on — which
# lands it in exactly the orphan state (process up, no JACK client, commands
# silently discarded) that sl-watchdog.service exists to alarm on.
After=mpe-jackd.service surge-xt-cli.service sound.target
Wants=mpe-jackd.service surge-xt-cli.service
ConditionPathExists=/home/mitch/MPE-Module/scripts/mpe-looper.py

[Service]
Type=simple
User=mitch
WorkingDirectory=/home/mitch/MPE-Module
EnvironmentFile=-/etc/mpe/mpe.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/mitch/MPE-Module/scripts/mpe-looper-service.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

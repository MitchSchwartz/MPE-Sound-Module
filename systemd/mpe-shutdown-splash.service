[Unit]
Description=MPE Touch DSI Shutdown Splash (5 inch panel)
# Plymouth-like ordering: splash before systemd-poweroff/reboot/halt, not in-app hold.
# Ref: plymouth-poweroff.service.in (DefaultDependencies=no, Before=systemd-poweroff.service)
After=getty@tty1.service touch-patch-browser.service
Before=systemd-poweroff.service systemd-reboot.service systemd-halt.service
DefaultDependencies=no
Conflicts=shutdown-animation.service

[Service]
Type=simple
User=mitch
WorkingDirectory=/home/mitch/MPE-Module
EnvironmentFile=-/etc/mpe/mpe.env
Environment=SDL_VIDEODRIVER=kmsdrm
ExecStartPre=-/bin/systemctl stop getty@tty1.service
ExecStart=/home/mitch/MPE-Module/scripts/run-shutdown-splash.sh
StandardOutput=null
StandardError=journal
# Hold until power is cut — do not SIGTERM the splash while poweroff is pending.
TimeoutStopSec=infinity
KillMode=mixed

[Install]
WantedBy=halt.target reboot.target shutdown.target
